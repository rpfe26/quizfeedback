{
  "appId": "dev.ladigitale.quizfeedback",
  "productName": "QuizFeedback",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "server/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.education",
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "public/icon.png"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QuizFeedback"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Education",
    "icon": "public/icon.png"
  }
}
